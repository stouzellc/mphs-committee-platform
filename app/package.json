{
  "name": "mphs-class-of-2008",
  "version": "0.1.0",
  "private": true,
  "description": "MPHS Class of 2008 reunion and cruise experience with organizer workspace.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/server.js",
    "test": "node --test tests/*.test.js",
